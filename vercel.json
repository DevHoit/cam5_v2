{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "regions": [
    "gru1"
  ],
  "crons": [
    {
      "path": "/api/v1/alarms/evaluate",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/v1/notifications/process",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/v1/trends/aggregate",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/v1/reports/process",
      "schedule": "*/5 * * * *"
    }
  ]
}
