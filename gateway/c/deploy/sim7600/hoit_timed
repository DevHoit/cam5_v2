#!/bin/sh
set -eu

CONF="/data/hoit/config/hoit_time.conf"
STATE="/data/hoit/state/time.state"
RUNTIME="/cache/hoit/time_status.json"
LOG="/data/hoit/logs/hoit_time.log"
BIN="/data/hoit/bin/hoit_timectl"
VERSION="1.1.0"
# Mismo lock que hoit_conn_watchdog: /dev/smd8 no admite dos lectores a la vez.
AT_LOCK="/var/lock/hoit_at.lock"
SESSION_DIR="/data/hoit/state/portal_sessions"
# Cada cuánto se refresca time_status.json (el reloj de cabecera y el inicio del portal lo leen).
STATUS_REFRESH_SEC=30

mkdir -p /data/hoit/state /data/hoit/logs /cache/hoit /var/lock
[ -f "$STATE" ] || : > "$STATE"
chmod 600 "$STATE"

json_escape()
{
    printf '%s' "$1" |
      sed 's/\\/\\\\/g; s/"/\\"/g; s/\r//g; :a;N;$!ba;s/\n/\\n/g'
}

cfg()
{
    KEY="$1"
    DEFAULT="$2"
    VALUE="$(
      awk -F= -v key="$KEY" '
        /^[[:space:]]*#/ || /^[[:space:]]*$/ {next}
        $1==key {
          print substr($0,index($0,"=")+1)
          exit
        }
      ' "$CONF" 2>/dev/null
    )"

    [ -n "$VALUE" ] || VALUE="$DEFAULT"
    printf '%s' "$VALUE"
}

state_value()
{
    KEY="$1"
    DEFAULT="$2"
    VALUE="$(
      awk -F= -v key="$KEY" '
        $1==key {
          print substr($0,index($0,"=")+1)
          exit
        }
      ' "$STATE" 2>/dev/null
    )"

    [ -n "$VALUE" ] || VALUE="$DEFAULT"
    printf '%s' "$VALUE"
}

log_line()
{
    LEVEL="$1"
    MESSAGE="$2"
    STAMP="$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || date +%s)"
    printf '[%s] %s %s\n' "$STAMP" "$LEVEL" "$MESSAGE" >> "$LOG"
}

# Las sincronizaciones correctas se registran solo al recuperarse (antes, una línea por hora).
log_ok()
{
    [ "${PREV_SYNCED:-0}" = "1" ] || log_line INFO "$1"
}

# Zonas con reglas de horario de verano (POSIX TZ; la imagen no trae zoneinfo).
tz_rule()
{
    case "$1" in
        America/Santiago) printf '%s' '<-04>4<-03>,M9.1.6/24,M4.1.6/24' ;;
        America/Punta_Arenas) printf '%s' '<-03>3' ;;
        *) return 1 ;;
    esac
}

# Desfase local en minutos para el instante actual. Con TIMEZONE=fixed se usa UTC_OFFSET_MINUTES.
# Se calcula comparando la hora local con la UTC: el %z de busybox falla justo en los cambios.
effective_offset()
{
    ZONE="$(cfg TIMEZONE fixed)"
    RULE="$(tz_rule "$ZONE")" || RULE=""

    if [ -n "$RULE" ]; then
        NOW_E="$(date +%s 2>/dev/null)" || NOW_E=""
        LOCAL_TXT="$(TZ="$RULE" date -D %s -d "$NOW_E" '+%Y-%m-%d %H:%M:%S' 2>/dev/null)" || LOCAL_TXT=""
        LOCAL_E="$(date -u -D '%Y-%m-%d %H:%M:%S' -d "$LOCAL_TXT" +%s 2>/dev/null)" || LOCAL_E=""

        case "$NOW_E$LOCAL_E" in
            ''|*[!0-9]*) ;;
            *)
                printf '%s' $(( (LOCAL_E - NOW_E) / 60 ))
                return 0
                ;;
        esac
    fi

    VALUE="$(cfg UTC_OFFSET_MINUTES 0)"
    case "$VALUE" in ''|*[!0-9-]*) VALUE=0 ;; esac
    printf '%s' "$VALUE"
}

uptime_sec()
{
    awk '{printf "%d", $1}' /proc/uptime 2>/dev/null || echo 0
}

mark_clock()
{
    MARK_EPOCH="$(date +%s 2>/dev/null || echo 0)"
    MARK_UPTIME="$(uptime_sec)"
}

# Si el reloj saltó (arranque en 1980, ajuste manual, corrección grande), se corre el vencimiento
# de las sesiones del portal en la misma cantidad: antes, un salto hacia adelante cerraba la sesión
# de quien estaba cambiando la hora y la página parecía no aceptar el cambio.
after_clock_change()
{
    NOW_E="$(date +%s 2>/dev/null || echo 0)"
    JUMP=$(( (NOW_E - MARK_EPOCH) - ($(uptime_sec) - MARK_UPTIME) ))

    [ "$JUMP" -gt 120 ] || [ "$JUMP" -lt -120 ] || return 0

    log_line INFO "Reloj corregido en ${JUMP}s"

    for FILE in "$SESSION_DIR"/*; do
        [ -f "$FILE" ] || continue
        case "$FILE" in *.tmp.*) continue ;; esac

        awk -F'|' -v jump="$JUMP" '
          BEGIN { OFS="|" }
          NR==1 && $4 ~ /^[0-9]+$/ { $4 = sprintf("%d", $4 + jump) }
          { print }
        ' "$FILE" > "$FILE.tmp.$$" 2>/dev/null &&
          chmod 600 "$FILE.tmp.$$" &&
          mv "$FILE.tmp.$$" "$FILE" ||
          rm -f "$FILE.tmp.$$"
    done
}

save_state()
{
    LAST_SYNC="$1"
    LAST_ATTEMPT="$2"
    SOURCE="$3"
    SYNCED="$4"
    RESULT="$5"
    SERVER="$6"

    CLEAN_RESULT="$(printf '%s' "$RESULT" | tr '\r\n=' '   ')"
    CLEAN_SERVER="$(printf '%s' "$SERVER" | tr '\r\n=' '   ')"

    cat > "$STATE.tmp.$$" <<EOF
last_sync_epoch=$LAST_SYNC
last_attempt_epoch=$LAST_ATTEMPT
source=$SOURCE
synchronized=$SYNCED
result=$CLEAN_RESULT
server=$CLEAN_SERVER
EOF

    chmod 600 "$STATE.tmp.$$"
    mv "$STATE.tmp.$$" "$STATE"
}

write_status()
{
    MODE="$(cfg MODE ntp)"
    ZONE="$(cfg TIMEZONE fixed)"
    OFFSET="$(effective_offset)"
    INTERVAL="$(cfg SYNC_INTERVAL_SEC 21600)"
    SERVERS="$(cfg NTP_SERVERS pool.ntp.org)"
    CELLULAR_DEVICE="$(cfg CELLULAR_DEVICE /dev/smd8)"

    case "$OFFSET" in ''|*[!0-9-]*) OFFSET=0 ;; esac
    case "$INTERVAL" in ''|*[!0-9]*) INTERVAL=21600 ;; esac

    LAST_SYNC="$(state_value last_sync_epoch 0)"
    LAST_ATTEMPT="$(state_value last_attempt_epoch 0)"
    SOURCE="$(state_value source none)"
    SYNCED="$(state_value synchronized 0)"
    RESULT="$(state_value result not_synced)"
    SERVER="$(state_value server "")"

    case "$LAST_SYNC" in ''|*[!0-9]*) LAST_SYNC=0 ;; esac
    case "$LAST_ATTEMPT" in ''|*[!0-9]*) LAST_ATTEMPT=0 ;; esac
    [ "$SYNCED" = "1" ] || SYNCED=0

    CLOCK="$("$BIN" --clock "$OFFSET" 2>/dev/null || true)"
    EPOCH="$(printf '%s' "$CLOCK" | awk -F'|' '{print $1}')"
    UTC_ISO="$(printf '%s' "$CLOCK" | awk -F'|' '{print $2}')"
    LOCAL_ISO="$(printf '%s' "$CLOCK" | awk -F'|' '{print $3}')"
    OFFSET_LABEL="$(printf '%s' "$CLOCK" | awk -F'|' '{print $4}')"

    case "$EPOCH" in ''|*[!0-9]*) EPOCH=0 ;; esac

    NEXT_SYNC=0
    if [ "$MODE" != "manual" ] && [ "$LAST_ATTEMPT" -gt 0 ]; then
        NEXT_SYNC=$((LAST_ATTEMPT + INTERVAL))
    fi

    cat > "$RUNTIME.tmp.$$" <<EOF
{
  "schema":"hoit.time.v1",
  "generated_epoch":$EPOCH,
  "system_epoch":$EPOCH,
  "utc_iso":"$(json_escape "$UTC_ISO")",
  "local_iso":"$(json_escape "$LOCAL_ISO")",
  "utc_offset_minutes":$OFFSET,
  "utc_label":"$(json_escape "$OFFSET_LABEL")",
  "timezone":"$(json_escape "$ZONE")",
  "mode":"$(json_escape "$MODE")",
  "source":"$(json_escape "$SOURCE")",
  "synchronized":$([ "$SYNCED" = 1 ] && echo true || echo false),
  "last_sync_epoch":$LAST_SYNC,
  "last_attempt_epoch":$LAST_ATTEMPT,
  "next_sync_epoch":$NEXT_SYNC,
  "result":"$(json_escape "$RESULT")",
  "server":"$(json_escape "$SERVER")",
  "ntp_servers":"$(json_escape "$SERVERS")",
  "cellular_device":"$(json_escape "$CELLULAR_DEVICE")"
}
EOF

    chmod 644 "$RUNTIME.tmp.$$"
    mv "$RUNTIME.tmp.$$" "$RUNTIME"
}

try_ntp()
{
    SERVERS="$(cfg NTP_SERVERS pool.ntp.org)"
    TIMEOUT="$(cfg NTP_TIMEOUT_SEC 8)"

    case "$TIMEOUT" in ''|*[!0-9]*) TIMEOUT=8 ;; esac

    OLD_IFS="$IFS"
    IFS=','
    set -- $SERVERS
    IFS="$OLD_IFS"

    for SERVER in "$@"; do
        [ -n "$SERVER" ] || continue
        OUTPUT="$("$BIN" --ntp "$SERVER" "$TIMEOUT" 2>&1)" && {
            NTP_SERVER="$(printf '%s' "$OUTPUT" | awk -F'|' '{print $2}')"
            [ -n "$NTP_SERVER" ] || NTP_SERVER="$SERVER"
            SYNC_OUTPUT="$OUTPUT"
            return 0
        }
        LAST_ERROR="$OUTPUT"
    done

    return 1
}

try_cellular()
{
    DEVICE="$(cfg CELLULAR_DEVICE /dev/smd8)"
    TIMEOUT="$(cfg NTP_TIMEOUT_SEC 8)"

    case "$DEVICE" in /dev/smd8|/dev/smd[0-9]|/dev/smd[0-9][0-9]) ;; *) LAST_ERROR="cellular device not allowed"; return 1 ;; esac
    case "$TIMEOUT" in ''|*[!0-9]*) TIMEOUT=8 ;; esac

    OUTPUT="$(flock -x "$AT_LOCK" "$BIN" --cclk "$DEVICE" "$TIMEOUT" 2>&1)" && {
        SYNC_OUTPUT="$OUTPUT"
        CELLULAR_SOURCE="$DEVICE"
        return 0
    }

    LAST_ERROR="$OUTPUT"
    return 1
}

sync_once()
{
    MODE="$(cfg MODE ntp)"
    FALLBACK="$(cfg CELLULAR_FALLBACK 0)"
    NOW="$(date +%s 2>/dev/null || echo 0)"
    LAST_SYNC="$(state_value last_sync_epoch 0)"
    LAST_ERROR=""
    SYNC_OUTPUT=""
    NTP_SERVER=""
    CELLULAR_SOURCE=""
    PREV_SYNCED="$(state_value synchronized 0)"
    PREV_RESULT="$(state_value result "")"

    case "$NOW" in ''|*[!0-9]*) NOW=0 ;; esac
    case "$LAST_SYNC" in ''|*[!0-9]*) LAST_SYNC=0 ;; esac
    [ "$FALLBACK" = "1" ] || FALLBACK=0
    mark_clock

    if [ "$MODE" = "manual" ]; then
        save_state "$LAST_SYNC" "$NOW" "manual" "1" "manual_time_retained" ""
        write_status
        return 0
    fi

    if [ "$MODE" = "ntp" ] || [ "$MODE" = "auto" ]; then
        if try_ntp; then
            SYNC_EPOCH="$(printf '%s' "$SYNC_OUTPUT" | awk -F'|' '{print $1}')"
            case "$SYNC_EPOCH" in ''|*[!0-9]*) SYNC_EPOCH="$(date +%s)" ;; esac
            save_state "$SYNC_EPOCH" "$NOW" "ntp" "1" "sync_ok" "$NTP_SERVER"
            after_clock_change
            log_ok "NTP sync successful server=$NTP_SERVER"
            write_status
            return 0
        fi
    fi

    if [ "$MODE" = "cellular" ] || { [ "$MODE" = "auto" ] && [ "$FALLBACK" = "1" ]; }; then
        if try_cellular; then
            SYNC_EPOCH="$(printf '%s' "$SYNC_OUTPUT" | awk -F'|' '{print $1}')"
            case "$SYNC_EPOCH" in ''|*[!0-9]*) SYNC_EPOCH="$(date +%s)" ;; esac
            save_state "$SYNC_EPOCH" "$NOW" "cellular" "1" "sync_ok" "$CELLULAR_SOURCE"
            after_clock_change
            log_ok "Cellular RTC sync successful device=$CELLULAR_SOURCE"
            write_status
            return 0
        fi
    fi

    [ -n "$LAST_ERROR" ] || LAST_ERROR="no_time_source_succeeded"
    save_state "$LAST_SYNC" "$NOW" "none" "0" "$LAST_ERROR" ""
    # Solo cuando cambia el motivo: sin red, antes escribía en /data cada minuto.
    CLEAN_ERROR="$(printf '%s' "$LAST_ERROR" | tr '\r\n=' '   ')"
    [ "$PREV_SYNCED" = "0" ] && [ "$PREV_RESULT" = "$CLEAN_ERROR" ] ||
        log_line WARN "Time sync failed: $LAST_ERROR"
    write_status
    return 1
}

manual_set()
{
    LOCAL_VALUE="$1"
    OFFSET="$2"

    mark_clock
    EPOCH="$("$BIN" --set-local "$LOCAL_VALUE" "$OFFSET" 2>&1)" || {
        echo "$EPOCH" >&2
        return 1
    }

    NOW="$(date +%s 2>/dev/null || echo "$EPOCH")"
    save_state "$NOW" "$NOW" "manual" "1" "manual_set_ok" ""
    after_clock_change
    log_line INFO "Manual time set local=$LOCAL_VALUE offset=$OFFSET"
    write_status
}

case "${1:-}" in
    --version)
        printf 'hoit_timed %s\n' "$VERSION"
        ;;
    --once)
        sync_once
        ;;
    --manual)
        [ -n "${2:-}" ] && [ -n "${3:-}" ] || {
            echo "Usage: $0 --manual LOCAL_ISO OFFSET_MINUTES" >&2
            exit 2
        }
        manual_set "$2" "$3"
        ;;
    --status)
        write_status
        cat "$RUNTIME"
        ;;
    --daemon|"")
        log_line INFO "hoit_timed started"

        while :; do
            if sync_once; then
                SLEEP="$(cfg SYNC_INTERVAL_SEC 21600)"
            else
                SLEEP="$(cfg RETRY_INTERVAL_SEC 60)"
            fi

            case "$SLEEP" in ''|*[!0-9]*) SLEEP=60 ;; esac
            [ "$SLEEP" -ge 30 ] || SLEEP=30

            # Antes dormía de una vez: time_status.json quedaba con la hora de la última
            # sincronización y el reloj del portal retrocedía hasta una hora cada 15 s.
            WAITED=0
            while [ "$WAITED" -lt "$SLEEP" ]; do
                sleep "$STATUS_REFRESH_SEC"
                WAITED=$((WAITED + STATUS_REFRESH_SEC))
                write_status || true
            done
        done
        ;;
    *)
        echo "Usage: $0 {--version|--once|--manual ISO OFFSET|--status|--daemon}" >&2
        exit 2
        ;;
esac
