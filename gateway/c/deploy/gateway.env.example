# /data/cam5-gateway/gateway.env — configuración del gateway C en el SIM7600.
# Permisos: chmod 600. Sin comillas alrededor de los valores.

# Portal HoitLive Core
CAM5_API_BASE=https://core.hoitlive.com/api/v1
# Token de Administración → Provisionamiento (se muestra una sola vez)
CAM5_GATEWAY_TOKEN=cam5gw_...

# Flash persistente del módulo: nunca /tmp (es RAM y se borra al reiniciar)
CAM5_STATE_DIR=/data/cam5-gateway

# Certificados raíz para validar core.hoitlive.com. OpenLinux no siempre trae
# un almacén de certificados; copia uno junto al binario (ver README).
CAM5_CA_FILE=/data/cam5-gateway/ca-certificates.crt

# Red hacia el CAM-5: IP fija del gateway en la red del CAM-5 (la aplica el servicio al arrancar)
CAM5_ETH_IFACE=eth0
CAM5_ETH_ADDR=192.168.1.10/24

# Registro con rotación automática (512 KB + una copia anterior)
CAM5_LOG_FILE=/data/cam5-gateway/gateway.log
CAM5_LOG_LEVEL=INFO

# Opcional: IP/puerto distintos de los registrados en el portal
# CAM5_HOST_OVERRIDES=CAM5-CTRL-01=192.168.1.101:502,CAM5-CTRL-02=192.168.1.102:502

# Opcional: tope de la cola en flash y timeout por solicitud sobre 4G
# CAM5_QUEUE_MAX_MB=16
# CAM5_HTTP_TIMEOUT=20

# Opcional: el heartbeat solo sale tras N s sin contacto. La alarma de comunicación del
# portal usa la hora del último lote (staleAfterSeconds del perfil, 900 s en cam5-balanced),
# así que con lotes cada 5 min un heartbeat intermedio no aporta: 600 ahorra decenas de MB/mes.
# Con un portal que acepta salud, igual sale un heartbeat con salud cada 15 min.
# CAM5_HEARTBEAT_IDLE_S=600
# Consulta de configuración (con ETag): cada 60 min por omisión.
# CAM5_CONFIG_REFRESH_MIN=60
