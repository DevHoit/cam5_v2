[Unit]
Description=HOIT Gateway Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hoit
Group=hoit
WorkingDirectory=/opt/hoit
EnvironmentFile=/etc/hoit-agent/agent.env
ExecStart=/usr/bin/python3 -m gateway.hoit_agent
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hoit-agent
UMask=0077

[Install]
WantedBy=multi-user.target
