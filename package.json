{
  "name": "cam5-core-portal",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:db": "tsx --test tests/database-schema.test.mjs tests/database-seed.test.ts tests/gateway-auth.test.ts tests/alarm-engine.test.ts tests/trends.test.ts tests/telemetry-aggregation.test.ts tests/notification-engine.test.ts tests/report-engine.test.ts tests/password-reset.test.ts tests/commissioning-engine.test.ts tests/authorization.test.ts tests/login-lockout.test.ts tests/app-url.test.ts tests/notification-endpoints.test.ts tests/report-schedules.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx db/migrate.ts",
    "db:seed": "tsx db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "gateway:token": "tsx db/create-gateway-token.ts"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.46.0",
    "drizzle-orm": "0.45.2",
    "next": "^16.4.5",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.7",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.4.5",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  },
  "type": "module"
}
